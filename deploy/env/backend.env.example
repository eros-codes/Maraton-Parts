# Maraton Parts API - production environment.
# Copy to /etc/maraton-parts/backend.env, fill in every CHANGE_ME, then:
#   chown root:maratonparts /etc/maraton-parts/backend.env && chmod 640 /etc/maraton-parts/backend.env
# Plain KEY=value lines only: systemd reads this file directly.

NODE_ENV=production
PORT=3000

# A public portfolio demo: allows the Zarinpal sandbox and the nightly
# reset from seed data. Remove this line for a real shop.
DEMO_MODE=true

# nginx sits in front of the API. Without this every visitor would share
# one IP address for the rate limits, and one person mistyping a password
# would lock everyone out of signing in.
TRUST_PROXY=1

# --- database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=maraton_parts
DB_PASSWORD=CHANGE_ME
DB_DATABASE=maraton_parts
DB_POOL_SIZE=10

# --- secrets: generate each with `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_ME
OTP_HASH_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=30
OTP_EXPIRATION_MINUTES=5

# --- public addresses
# BACKEND_URL is where payment callbacks and image links point, so it is the
# API as seen from outside: the store host plus /api.
BACKEND_URL=https://shop.aboutarvin.ir/api
FRONTEND_URL=https://shop.aboutarvin.ir
CORS_ORIGIN=https://shop.aboutarvin.ir,https://admin.shop.aboutarvin.ir

# --- files
# Outside the code directory, so a redeploy never touches uploaded images.
UPLOAD_DIR=/var/lib/maraton-parts/uploads

# --- payments
# Sandbox in the demo; any 36-character UUID is accepted as a merchant id.
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# --- SMS
# Left empty in the demo: registration then answers 503 and visitors use the
# demo accounts shown on the portfolio page. Fill both in for a real shop.
#
# Each template must use exactly the parameter names below - sms.ir rejects
# a message whose parameters do not match its template.
#   OTP template:               #CODE#
#   account exists:             #MOBILE#
#   order placed/paid/delivered/cancelled:  #ORDER# (invoice number), #AMOUNT#
#   order sent:                 #ORDER#, #AMOUNT#, #TRACKING#, #CARRIER#
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
# Optional: told to a number that tries to sign up again.
SMSIR_ACCOUNT_EXISTS_TEMPLATE_ID=
# Order updates to the customer, one approved template each. An empty one
# is simply not sent, so they can be switched on one at a time.
SMSIR_ORDER_PLACED_TEMPLATE_ID=
SMSIR_ORDER_PAID_TEMPLATE_ID=
SMSIR_ORDER_SENT_TEMPLATE_ID=
SMSIR_ORDER_DELIVERED_TEMPLATE_ID=
SMSIR_ORDER_CANCELLED_TEMPLATE_ID=

# --- API docs stay off in production
SWAGGER_ENABLED=false

# --- error reporting
# A Sentry project's DSN: crashes and failed requests are sent there with
# their stack trace, instead of only scrolling past in the journal.
SENTRY_DSN=

# --- Shop details (storefront contact and legal pages) ------------------
# All optional. A value left empty is simply not shown - nothing is
# invented in its place. ENAMAD_ID and ENAMAD_CODE come from the trust-seal
# snippet enamad.ir gives you (…?id=<ID>&Code=<CODE>); the badge appears in
# the footer only when both are set.
SHOP_LEGAL_NAME=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_ADDRESS=
SHOP_SUPPORT_HOURS=
SHOP_INSTAGRAM_URL=
SHOP_TELEGRAM_URL=
ENAMAD_ID=
ENAMAD_CODE=

# --- Admin security -----------------------------------------------------
# Two-step sign-in for admins (a 6-digit code from Google Authenticator,
# Microsoft Authenticator or any authenticator app, after the password).
#   required = every admin; one without it sets it up at the next sign-in
#   optional = only admins who turned it on (panel -> امنیت حساب)
# Empty: required in production, optional in development and on a demo.
ADMIN_TWO_FACTOR=

# Instant alerts to the shop owner when an admin account is locked by
# wrong passwords, an admin session looks stolen, someone becomes admin,
# or two-step sign-in is switched off / reset. Both channels optional.
#
# SMS: an sms.ir template with one parameter EVENT, e.g.
#   "هشدار امنیتی ماراتون پارتز: #EVENT#"
SECURITY_ALERT_MOBILES=
SMSIR_SECURITY_ALERT_TEMPLATE_ID=
# Bot: Bale by default (reachable from Iranian servers). For Telegram set
# ALERT_BOT_API=https://api.telegram.org. The chat id is the number the
# bot sees when you message it.
ALERT_BOT_TOKEN=
ALERT_BOT_CHAT_ID=
ALERT_BOT_API=

# Address to listen on. Empty: 127.0.0.1 in production (only nginx on the
# same machine talks to the API), every interface elsewhere.
HOST=
